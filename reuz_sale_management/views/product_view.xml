<?xml version="1.0" ?>

<odoo>
    <record id="view_product_form" model="ir.ui.view">
        <field name="name">product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='internal_notes']" position="before">
                <group name="reuz_fields" string="Reuz Fields">
                    <field name="product_format" />
                    <field name="product_volume" />
                    <field name="product_base" />
                    <field name="product_color" />
                    <field name="product_technology" />
                    <field name="api_reference" readonly="1" />
                    <field name="silver_reference" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_list" model="ir.ui.view">
        <field name="name">product.template.list</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="api_reference" />
                <field name="silver_reference" />
            </xpath>
        </field>
    </record>

    <record id="view_product_tree" model="ir.ui.view">
        <field name="name">product.template.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='d-flex mb-0 h5']" position="inside">
                <div class="d-flex flex-column">
                    <field name="name"/>
                    <span>API Ref: <field name="api_reference"/></span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

