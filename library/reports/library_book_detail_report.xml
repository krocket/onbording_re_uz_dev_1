<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="library_book_detail_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o" >
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="row">
                                <div class="col-3">
                                    <img t-if="o.image" t-att-src="'data:image/png;base64,%s' % o.image.decode()" style="max-width: 100%; border-radius: 8px; border: 1px solid #ccc;"/>
                                </div>
                                <div class="col-9">
                                    <h1><t t-esc="o.name"/></h1>
                                    <p><strong>Auteur(s) :</strong> <t t-esc="', '.join([a.name for a in o.author_ids]) if o.author_ids else 'Non spécifié'"/></p>
                                    <p><strong>Éditeur :</strong> <t t-esc="o.publisher_id.name if o.publisher_id else 'Non spécifié'"/></p>
                                    <p><strong>Catégorie :</strong> <t t-esc="o.category_id.name if o.category_id else 'Non spécifié'"/></p>
                                    <p><strong>Date de publication :</strong> <t t-esc="o.publication_date.strftime('%d/%m/%Y') if o.publication_date else 'Non spécifié'"/></p>
                                    <p><strong>ISBN :</strong> <t t-esc="o.isbn or 'Non spécifié'"/></p>
                                    <p><strong>État :</strong> <t t-esc="dict(o._fields['state'].selection).get(o.state, o.state)"/></p>
                                    <p><strong>Référence :</strong> <t t-esc="o.reference or 'Non spécifié'"/></p>
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col-12">
                                    <h4>Description</h4>
                                    <p><t t-esc="o.description or 'Aucune description.'"/></p>
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col-12 text-center">
                                    <p class="text-muted">
                                        Ce rapport a été généré automatiquement par le système de gestion de bibliothèque.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div style="page-break-after: always;"></div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo> 