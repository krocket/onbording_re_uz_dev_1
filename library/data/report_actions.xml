<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action pour le rapport dans le menu Action -->
        <record id="action_library_book_report_action" model="ir.actions.act_window">
            <field name="name">Générer Rapport PDF</field>
            <field name="res_model">library.book</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'action_generate_pdf_report': True}</field>
            <field name="target">current</field>
        </record>

        <!-- Menu dans la roue dentée pour les livres -->
        <record id="menu_library_book_report_action" model="ir.ui.menu">
            <field name="name">Générer Rapport PDF</field>
            <field name="parent_id" ref="library.menu_library_book"/>
            <field name="action" ref="action_library_book_report_action"/>
            <field name="sequence">30</field>
        </record>

        <!-- Action de rapport pour la roue dentée -->
        <record id="action_library_book_report_print" model="ir.actions.report">
            <field name="name">Imprimer Rapport</field>
            <field name="model">library.book</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">library.library_book_report</field>
            <field name="report_file">library.library_book_report</field>
            <field name="binding_model_id" ref="model_library_book"/>
            <field name="binding_type">report</field>
            <field name="binding_view_types">list,form</field>
        </record>
    </data>
</odoo> 