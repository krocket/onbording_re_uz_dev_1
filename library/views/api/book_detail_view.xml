<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue API pour les détails d'un livre -->
    <template id="book_detail_template" name="Book Detail Template">
        <t t-call="web.layout">
            <div class="container py-5" style="background: #f8f9fa; min-height: 100vh;">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h1 class="text-primary"><i class="fa fa-book"></i> Détails du livre</h1>
                            <a href="/api/books" class="btn btn-outline-primary">
                                <i class="fa fa-arrow-left"></i> Retour à la liste
                            </a>
                        </div>
                        <div class="card shadow-lg border-0">
                            <div class="row no-gutters">
                                <div class="col-md-4 d-flex align-items-center justify-content-center p-4">
                                    <img t-att-src="'/web/image/library.book/' + str(book['id']) + '/image'" class="img-fluid rounded book-image-detail" style="max-height: 260px; background: #e9ecef;" t-att-alt="book['name']" onerror="this.src='/web/static/src/img/placeholder.png'"/>
                                </div>
                                <div class="col-md-8">
                                    <div class="card-body">
                                        <h2 class="card-title text-primary mb-3"><t t-esc="book['name']"/></h2>
                                        <span t-att-class="'badge badge-' + ('success' if book['state'] == 'available' else 'warning' if book['state'] == 'borrowed' else 'danger') + ' mb-3 px-3 py-2'" style="font-size:1em;">
                                            <i class="fa fa-circle"></i> <t t-esc="book['state']"/>
                                        </span>
                                        <t t-if="book['description']">
                                            <h5 class="mt-3">Description</h5>
                                            <p class="card-text"><t t-esc="book['description']"/></p>
                                        </t>
                                        <h5 class="mt-4">Informations</h5>
                                        <ul class="list-unstyled mb-0">
                                            <li class="mb-1"><strong><i class="fa fa-user text-info"></i> Auteurs :</strong> 
                                                <t t-if="book['authors'] and len(book['authors']) > 0">
                                                    <t t-esc="', '.join(book['authors'])"/>
                                                </t>
                                                <t t-else="">Auteur inconnu</t>
                                            </li>
                                            <li class="mb-1"><strong><i class="fa fa-tag text-warning"></i> Catégorie :</strong> 
                                                <t t-if="book['category']"><t t-esc="book['category']"/></t>
                                                <t t-else="">Catégorie inconnue</t>
                                            </li>
                                            <li class="mb-1"><strong><i class="fa fa-building text-success"></i> Éditeur :</strong> 
                                                <t t-if="book['publisher']"><t t-esc="book['publisher']"/></t>
                                                <t t-else="">Éditeur inconnu</t>
                                            </li>
                                            <t t-if="book['isbn']">
                                                <li class="mb-1"><strong><i class="fa fa-barcode text-secondary"></i> ISBN :</strong> <t t-esc="book['isbn']"/></li>
                                            </t>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <style>
                .book-image-detail {
                    border-radius: 12px;
                    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
                }
            </style>
        </t>
    </template>
</odoo> 