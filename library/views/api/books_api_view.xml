<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue API pour la liste des livres -->
    <template id="books_list_template" name="Books List Template">
        <t t-call="web.layout">
            <div class="container-fluid py-4" style="background: #f8f9fa; min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h1 class="text-primary"><i class="fa fa-book"></i> <t t-esc="title"/></h1>
                            <a href="/api/books" class="btn btn-outline-primary">
                                <i class="fa fa-home"></i> Accueil
                            </a>
                        </div>
                        <!-- Barre de recherche -->
                        <div class="row mb-4">
                            <div class="col-md-6 offset-md-3">
                                <form method="GET" action="/api/books/search" class="input-group shadow-sm">
                                    <input type="text" name="q" class="form-control" placeholder="Rechercher un livre, auteur, catégorie..." 
                                           t-att-value="search_term or ''"/>
                                    <div class="input-group-append">
                                        <button class="btn btn-primary" type="submit">
                                            <i class="fa fa-search"></i> Rechercher
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <!-- Statistiques -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="alert alert-info text-center shadow-sm">
                                    <i class="fa fa-info-circle"></i>
                                    <strong>Nombre de livres:</strong> <t t-esc="count"/>
                                </div>
                            </div>
                        </div>
                        <!-- Liste des livres -->
                        <div class="row gx-4 gy-4 justify-content-start">
                            <t t-if="books">
                                <t t-foreach="books" t-as="book">
                                    <div class="col-12 col-sm-6 col-md-6 col-lg-4 col-xl-3 d-flex align-items-stretch">
                                        <div class="card h-100 shadow border-0 book-card w-100">
                                            <div class="position-relative">
                                                <img t-att-src="'/web/image/library.book/' + str(book['id']) + '/image'" class="card-img-top book-image" 
                                                     style="height: 220px; object-fit: cover; background: #e9ecef;" 
                                                     t-att-alt="book['name']" 
                                                     onerror="this.src='/web/static/src/img/placeholder.png'"/>
                                                <span t-att-class="'badge state-badge badge-' + ('success' if book['state'] == 'available' else 'warning' if book['state'] == 'borrowed' else 'danger') + ' position-absolute rounded-pill shadow'" 
                                                      style="top: 10px; right: 10px; font-size: 0.9em;">
                                                    <i class="fa fa-circle"></i> <t t-esc="book['state']"/>
                                                </span>
                                            </div>
                                            <div class="card-body d-flex flex-column">
                                                <h5 class="card-title text-primary mb-2"><i class="fa fa-book"></i> <t t-esc="book['name']"/></h5>
                                                <p class="card-text text-muted small mb-1">
                                                    <i class="fa fa-user text-info"></i> <strong>Auteurs :</strong> 
                                                    <t t-if="book['authors'] and len(book['authors']) > 0">
                                                        <t t-esc="', '.join(book['authors'])"/>
                                                    </t>
                                                    <t t-else="">Auteur inconnu</t>
                                                </p>
                                                <p class="card-text text-muted small mb-1">
                                                    <i class="fa fa-tag text-warning"></i> <strong>Catégorie:</strong> 
                                                    <t t-if="book['category']"><t t-esc="book['category']"/></t>
                                                    <t t-else="">Catégorie inconnue</t>
                                                </p>
                                                <p class="card-text text-muted small mb-1">
                                                    <i class="fa fa-building text-success"></i> <strong>Éditeur:</strong> 
                                                    <t t-if="book['publisher']"><t t-esc="book['publisher']"/></t>
                                                    <t t-else="">Éditeur inconnu</t>
                                                </p>
                                                <t t-if="book['isbn']">
                                                    <p class="card-text text-muted small mb-1">
                                                        <i class="fa fa-barcode text-secondary"></i> <strong>ISBN:</strong> <t t-esc="book['isbn']"/>
                                                    </p>
                                                </t>
                                                <p class="card-text text-muted small mb-2">
                                                    <i class="fa fa-check-circle text-primary"></i> <strong>État:</strong> <t t-esc="book['state']"/>
                                                </p>
                                                <div class="mt-auto text-center">
                                                    <a t-att-href="'/api/books/' + str(book['id'])" class="btn btn-outline-primary btn-sm rounded-pill px-4 shadow-sm">
                                                        <i class="fa fa-eye"></i> Voir détails
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="col-12 text-center">
                                    <div class="alert alert-warning">
                                        <i class="fa fa-exclamation-triangle"></i>
                                        <strong>Aucun livre trouvé</strong>
                                        <p class="mb-0">Essayez de modifier vos critères de recherche.</p>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
            <style>
                .book-card {
                    transition: transform 0.2s, box-shadow 0.2s;
                    cursor: pointer;
                    border-radius: 12px;
                }
                .book-card:hover {
                    transform: translateY(-5px) scale(1.02);
                    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
                }
                .book-image {
                    border-top-left-radius: 12px;
                    border-top-right-radius: 12px;
                }
                .state-badge {
                    position: absolute;
                    top: 10px;
                    right: 10px;
                    font-size: 0.9em;
                    padding: 0.5em 1em;
                }
            </style>
        </t>
    </template>
</odoo> 