<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue API pour les erreurs -->
    <template id="error_template" name="Error Template">
        <t t-call="web.layout">
            <t t-set="head">
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"/>
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
            </t>
            <div class="container-fluid">
                <div class="row">
                    <div class="col-12">
                        <div class="text-center mt-5">
                            <h1 class="text-danger">
                                <i class="fa fa-exclamation-triangle"></i> Erreur
                            </h1>
                            <div class="alert alert-danger" role="alert">
                                <h4 class="alert-heading">Une erreur s'est produite</h4>
                                <p><t t-esc="error_message"/></p>
                            </div>
                            <a href="/api/books" class="btn btn-primary">
                                <i class="fa fa-home"></i> Retour à l'accueil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo> 