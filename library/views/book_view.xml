<?xml version="1.0" ?>

<odoo>
    <record id="view_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <separator string="Details"/>
                            <field name="image"/>
                            <field name="publication_date"/>
                            <field name="isbn"/>
                            <field name="publisher_id" widget="many2one_tags"/>
                            <field name="author_ids" widget="many2many_tags"/>
                            <field name="category_id" widget="many2one_tags"/>
                        </group>
                        <group>
                            <separator string="Etat"/>
                            <field name="active"/>
                            <field name="state"/>
                            <field name="loan_date"/>
                            <field name="return_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget="image"/>
                <field name="name"/>
                <field name="state"/>
                <field name="category_id" widget="many2one_tags"/>
                <field name="author_ids" widget="many2many_tags"/>
                <field name="publication_date" widget="date" optional="hide"/>
                <field name="publisher_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_state_available" string="State Available" domain="[('state', '=', 'available')]"/>
                <filter name="filter_state_borrowed" string="State Borrowed" domain="[('state', '=', 'borrowed')]"/>
                <filter name="filter_state_lost" string="State Lost" domain="[('state', '=', 'lost')]"/>
                <group expand="1" string="Group By">
                    <field string="Authors" name="author_ids" context="{'group_by': 'author_ids'}"/>
                </group>
            </search>
        </field>
    </record>


</odoo>