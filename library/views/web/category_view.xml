<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire pour les catégories -->
    <record id="view_category_form" model="ir.ui.view">
        <field name="name">library.book.category.form</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="child_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste pour les catégories -->
    <record id="view_category_list" model="ir.ui.view">
        <field name="name">library.book.category.list</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="child_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
</odoo>