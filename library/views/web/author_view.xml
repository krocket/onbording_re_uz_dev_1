<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire pour les auteurs -->
    <record id="view_author_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form string="Author">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="biography"/>
                        <field name="birth_date"/>
                        <field name="death_date"/>
                        <field name="nationality"/>
                        <field name="website"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="address"/>
                        <field name="image"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste pour les auteurs -->
    <record id="view_author_list" model="ir.ui.view">
        <field name="name">library.author.list</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="birth_date"/>
                <field name="nationality"/>
                <field name="email"/>
                <field name="active"/>
            </list>
        </field>
    </record>
</odoo>