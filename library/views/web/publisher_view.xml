<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire pour les éditeurs -->
    <record id="view_publisher_form" model="ir.ui.view">
        <field name="name">library.publisher.form</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <form string="Publisher">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="founded_date"/>
                        <field name="website"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="address"/>
                        <field name="country_id" widget="many2one_tags"/>
                        <field name="logo" widget="image"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste pour les éditeurs -->
    <record id="view_publisher_list" model="ir.ui.view">
        <field name="name">library.publisher.list</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="website"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="country_id" widget="many2one_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>
</odoo>