<?xml version="1.0" ?>

<odoo>
    <record id="view_publisher_form" model="ir.ui.view">
        <field name="name">library.publisher.form</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <form string="Publisher">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="founded_date"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="address"/>
                        <field name="country_id" widget="many2one_tags"/>
                        <field name="logo" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_publisher_list" model="ir.ui.view">
        <field name="name">library.publisher.list</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="address"/>
                <field name="country_id" widget="many2one_tags"/>
            </list>
        </field>
    </record>

    <record id="view_publisher_search" model="ir.ui.view">
        <field name="name">library.publisher.search</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

</odoo>