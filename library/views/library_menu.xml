<?xml version="1.0" ?>
<odoo>
    <menuitem id="library_menu" name="Library"/>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_library_book_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">library.book.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="library_book_menu" name="Books" parent="library_menu" action="library.action_library_book"/>
    <menuitem id="library_book_category_menu" name="Categories" parent="library_menu" action="library.action_library_book_category"/>
    
</odoo>